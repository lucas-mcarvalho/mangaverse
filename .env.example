# Copie para .env e ajuste. NUNCA versione o arquivo .env.

# Banco de dados
POSTGRES_DB=mangaverse
POSTGRES_USER=mangaverse
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5433

# Usuário administrador criado na primeira inicialização.
# Se a senha ficar vazia, uma senha aleatória é gerada e exibida no log do backend.
MANGAVERSE_ADMIN_USERNAME=admin
MANGAVERSE_ADMIN_PASSWORD=

# Pastas no computador host
# Linux:   MANGAVERSE_LIBRARY_HOST_DIR=/mnt/HD2/MangaVerse
# Windows: MANGAVERSE_LIBRARY_HOST_DIR=D:/MangaVerse
MANGAVERSE_LIBRARY_HOST_DIR=./data/library
MANGAVERSE_EXTRA_HOST_DIR=./data/extra

# UID/GID usados para gravar arquivos no host (Linux: rode `id -u` e `id -g`)
PUID=1000
PGID=1000

# Comic Vine (metadados de HQs). Chave gratuita em https://comicvine.gamespot.com/api/
# Uso permitido somente não comercial.
COMICVINE_API_KEY=

# Suwayomi
SUWAYOMI_ENABLED=true
SUWAYOMI_TAG=stable
SUWAYOMI_PORT=4567
# Serviço auxiliar para fontes com Cloudflare (ComicHubFree, Read Comics Online etc.).
SUWAYOMI_FLARESOLVERR_ENABLED=true
BYPARR_TAG=latest
# Preencha somente se ativar autenticação básica no Suwayomi
SUWAYOMI_USERNAME=
SUWAYOMI_PASSWORD=

# Portas publicadas
# Tradução: o Compose inicia translator na rede interna e mantém o modelo no volume translation_models.
# Para rodar o backend fora do Compose, configure MANGAVERSE_TRANSLATION_URL=http://localhost:8091
BACKEND_PORT=8090
FRONTEND_PORT=5180
# Use 0.0.0.0 para acessar de outros dispositivos da rede local
FRONTEND_BIND=127.0.0.1

# Identificação nas APIs externas (MangaDex exige User-Agent identificável)
MANGAVERSE_USER_AGENT=MangaVerse/0.1 (self-hosted)

TZ=America/Sao_Paulo
LOG_FORMAT=ecs
